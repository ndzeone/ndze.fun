# Что НЕ выкладывается на хостинг (rsync --exclude-from).
# Исключённые пути на сервере rsync тоже не удаляет — поэтому cgi-bin хостинга останется.
# Ведущий "/" — только в корне сайта (чтобы случайно не исключить папку внутри assets/).
.git/
.github/
.gitignore
.deployignore
/tools/
/supabase/
/tests/
*.md
/start.bat
/serve.ps1
/cgi-bin/
# служебная папка хостинга (проверка домена при выпуске SSL) — не удалять
/.well-known/
