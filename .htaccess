# Настройки Apache для хостинга Timeweb

DirectoryIndex index.html
# «Options -Indexes» не ставим: если хостинг запрещает Options в .htaccess, весь сайт отдаёт 500.
# Список файлов в папках на Timeweb и так выключен по умолчанию.
AddDefaultCharset UTF-8

# Типы файлов
AddType font/woff2 .woff2
AddType image/svg+xml .svg
AddType application/json .json
AddType text/javascript .js

<IfModule mod_rewrite.c>
  RewriteEngine On

  # HTTP → HTTPS (сертификат Let's Encrypt выпускает Timeweb; проверки продления в .well-known не трогаем)
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !=https
  RewriteCond %{HTTP_HOST} ^(www\.)?ndze\.fun$ [NC]
  RewriteCond %{REQUEST_URI} !^/\.well-known/
  RewriteRule ^ https://ndze.fun%{REQUEST_URI} [L,R=301]

  # www.ndze.fun → ndze.fun
  RewriteCond %{HTTP_HOST} ^www\.ndze\.fun$ [NC]
  RewriteRule ^ %{REQUEST_SCHEME}://ndze.fun%{REQUEST_URI} [L,R=301]

  # Скрытые файлы (.git, .env и т.п.) — запрещены
  RewriteRule (^|/)\.(?!well-known/) - [F]
</IfModule>

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"

  # HTML и список репозиториев — всегда свежие, остальное кэшируется на неделю
  <FilesMatch "\.(html|json)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
  <FilesMatch "\.(css|js|svg|png|jpg|jpeg|webp|gif|woff2)$">
    Header set Cache-Control "public, max-age=604800"
  </FilesMatch>
  # service worker браузер обязан перепроверять, иначе обновления push-уведомлений застрянут на неделю
  <Files "sw.js">
    Header set Cache-Control "no-cache"
  </Files>
</IfModule>

# Несуществующая страница → 404.html с мини-игрой (код ответа остаётся 404). Все ссылки внутри 404.html
# абсолютные (/assets/…), поэтому она работает на любом пути вроде /a/b/c.
ErrorDocument 404 /404.html
